# ==========================================
# CineStream / Top Canais - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env no Git!
# ==========================================

# Configurações do Servidor
PORT=3000
NODE_ENV=production

# Banco de Dados PostgreSQL (Coolify / Docker)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# Gateway de Pagamentos Mercado Pago (Access Token de Produção)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-0000000000

# Segurança e Autenticação JWT (HS256)
JWT_SECRET=defina_uma_chave_secreta_longa_e_forte_para_assinatura_jwt
LEGACY_JWT_SECRET=

# Usuário Master e Administração
MASTER_PASSWORD=defina_uma_senha_forte_para_o_usuario_master
ADMIN_SECRET_KEY=defina_uma_chave_secreta_para_auditoria
